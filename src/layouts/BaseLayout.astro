---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../data/company';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title = SITE.name, description = SITE.description, ogImage = '/images/tci_layanan_cargo_udara.png', canonicalUrl, jsonLd } = Astro.props;
const fullTitle = title === SITE.name ? title : `${title} | TCI`;
const currentUrl = canonicalUrl || Astro.url.href;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : SITE.url + ogImage;

// Default Organization schema (always present)
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": SITE.url + "/#organization",
  "name": SITE.name,
  "alternateName": "TCI",
  "url": SITE.url,
  "logo": SITE.url + "/images/brand/tci-logo.png",
  "image": SITE.url + ogImage,
  "description": "PT Terminal Cargo Indonesia — jasa pengiriman cargo udara, darat & laut dari Surabaya ke seluruh Indonesia.",
  "telephone": SITE.phone,
  "email": SITE.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Terminal Cargo T2 Bandara Juanda",
    "addressLocality": "Sidoarjo",
    "addressRegion": "Jawa Timur",
    "postalCode": "61253",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -7.3816923,
    "longitude": 112.7703073
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    "opens": "09:00",
    "closes": "23:59"
  },
  "sameAs": [
    SITE.social.facebook,
    SITE.social.instagram
  ],
  "priceRange": "$$",
  "currenciesAccepted": "IDR",
  "areaServed": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "founder": {
    "@type": "Organization",
    "name": "PT Terminal Cargo Indonesia"
  },
  "foundingDate": "2014"
};

// Merge schemas
const allSchemas: Record<string, unknown>[] = [orgSchema];
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    allSchemas.push(...jsonLd);
  } else {
    allSchemas.push(jsonLd);
  }
}
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={currentUrl} />
  <link rel="icon" type="image/png" href="/images/brand/tci-favicon.png" />
  <meta name="theme-color" content="#021B43" />
  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <!-- Google Fonts: Inter -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="id_ID" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />
  <meta name="robots" content="index, follow" />
  <!-- JSON-LD Structured Data -->
  {allSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <!-- GTM -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-M7J6H8GZ');</script>
  <ClientRouter />
</head>
<body class="bg-white text-gray-800 font-sans antialiased">
  <!-- GTM noscript -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M7J6H8GZ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- Page Curtain (navy sweep) -->
  <div id="page-curtain" transition:persist></div>
  <slot />
</body>
</html>

<script>
  declare const window: Window & { __curtainInit?: boolean };
  if (!window.__curtainInit) {
    window.__curtainInit = true;

    const curtain = document.getElementById('page-curtain');
    if (!curtain) throw new Error('page-curtain not found');

    const EASE = [0.65, 0, 0.35, 1] as [number, number, number, number];
    const DURATION_LEAVE = 680;
    const DURATION_ENTER = 920;
    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let leaveAnim: Animation | null = null;
    let enterAnim: Animation | null = null;

    function cancelAllCurtainAnimations(): void {
      if (leaveAnim) { try { leaveAnim.cancel(); } catch {} leaveAnim = null; }
      if (enterAnim) { try { enterAnim.cancel(); } catch {} enterAnim = null; }
      // Also cancel any leftover Web Animations API animations on the curtain
      curtain.getAnimations().forEach((a) => { try { a.cancel(); } catch {} });
    }

    // ── Leave: curtain sweeps from bottom up to cover screen ──
    // We play the leave animation immediately on before-preparation.
    // Astro 6 does NOT wait for this promise (return value ignored),
    // but that's fine — the animation runs concurrently with page fetch.
    document.addEventListener('astro:before-preparation', () => {
      if (prefersReducedMotion()) return;

      // Cancel any previous animations first (rapid navigation protection)
      cancelAllCurtainAnimations();
      curtain.style.transform = 'translateY(100%)';

      leaveAnim = curtain.animate([
        { transform: 'translateY(100%)' },
        { transform: 'translateY(0)' }
      ], {
        duration: DURATION_LEAVE,
        easing: `cubic-bezier(${EASE.join(',')})`,
        fill: 'forwards'
      });

      leaveAnim.addEventListener('finish', () => {
        leaveAnim = null;
      }, { once: true });
    });

    // ── Enter: curtain sweeps up revealing new page ──
    document.addEventListener('astro:after-swap', () => {
      // Always cancel stale leave animation (in case it's still running)
      if (leaveAnim) {
        try { leaveAnim.cancel(); } catch {}
        leaveAnim = null;
      }
      if (enterAnim) {
        try { enterAnim.cancel(); } catch {}
        enterAnim = null;
      }

      if (prefersReducedMotion()) {
        curtain.style.transform = 'translateY(100%)';
        return;
      }

      // Ensure curtain is fully covering screen before we start the reveal
      curtain.style.transform = 'translateY(0)';

      enterAnim = curtain.animate([
        { transform: 'translateY(0)' },
        { transform: 'translateY(-100%)' }
      ], {
        duration: DURATION_ENTER,
        easing: `cubic-bezier(${EASE.join(',')})`,
        fill: 'forwards'
      });

      enterAnim.addEventListener('finish', () => {
        curtain.style.transform = 'translateY(100%)';
        enterAnim = null;
      }, { once: true });
    });

    // ── Safety net: if curtain is stuck after 3s, force reset ──
    document.addEventListener('astro:after-swap', () => {
      setTimeout(() => {
        const currentAnims = curtain.getAnimations();
        const hasActiveAnim = currentAnims.some(a => a.playState === 'running');
        if (!hasActiveAnim) {
          // No active animation — make sure curtain is hidden
          const style = getComputedStyle(curtain);
          const ty = style.transform;
          // If curtain is not at translateY(100%) or translateY(-100%), force reset
          if (ty !== 'matrix(1, 0, 0, 1, 0, 0)' && !ty.includes('100%')) {
            // If it's visually blocking, just check if it covers viewport
            const rect = curtain.getBoundingClientRect();
            if (rect.top === 0 && rect.left === 0 && rect.width > 0 && rect.height > 0) {
              // Curtain is covering the viewport — force reset
              curtain.style.transform = 'translateY(100%)';
            }
          }
        }
      }, 3000);
    });

    // ── bfcache fix: cancel stale curtain on back/forward ──
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) {
        cancelAllCurtainAnimations();
        curtain.style.transform = 'translateY(100%)';
      }
    });
  }
</script>
