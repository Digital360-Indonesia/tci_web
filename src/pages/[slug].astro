---
import BaseLayout from '../layouts/BaseLayout.astro';
import Layout from '../components/layout/Layout.astro';
import Breadcrumb from '../components/shared/Breadcrumb.astro';
import Sidebar from '../components/blog/Sidebar.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';
import { SITE } from '../data/company';
import { getCollection, render } from 'astro:content';
import seoCities from '../data/seo-cities.json';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const seoCityData = seoCities as typeof seoCities;

  const blogPaths = allPosts.map((post) => ({
    params: { slug: post.data.slug },
    props: { type: 'blog' as const, post },
  }));

  const seoPaths = seoCityData.map((city) => ({
    params: { slug: city.slug },
    props: { type: 'seo' as const, city },
  }));

  return [...blogPaths, ...seoPaths];
}

const pageProps = Astro.props;
const isBlog = pageProps.type === 'blog';
const isSeo = pageProps.type === 'seo';

const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
}

const categoryLabels: Record<string, string> = {
  edukasi: 'Edukasi',
  promosi: 'Promosi',
  'tips-trik': 'Tips & Trik',
};

let pageTitle = '';
let pageDescription = '';
let pageOgImage = '/images/tci_layanan_cargo_udara.png';

if (isBlog) {
  const post = pageProps.post;
  pageTitle = post.data.title;
  pageDescription = post.data.metaDescription || post.data.excerpt;
  pageOgImage = post.data.ogImage || post.data.featuredImage || '/images/tci_layanan_cargo_udara.png';
} else {
  const city = pageProps.city;
  pageTitle = city.title;
  pageDescription = city.metaDescription || `Jasa ekspedisi termurah dari Surabaya ke ${city.cityName}. Pengiriman cargo udara, darat & laut. Door to Door. PT Terminal Cargo Indonesia.`;
  pageOgImage = city.ogImage || '/images/tci_layanan_cargo_udara.png';
}

let Content: any;
let blogPost: any;
let categoryLabel = '';
let hasFeaturedImage = false;
let allCategories: Array<{ slug: string; label: string; count: number }> = [];
let recentPosts: Array<{ title: string; slug: string; date: string }> = [];

if (isBlog) {
  blogPost = pageProps.post;
  const rendered = await render(blogPost);
  Content = rendered.Content;
  categoryLabel = categoryLabels[blogPost.data.category] || blogPost.data.category;
  hasFeaturedImage = blogPost.data.featuredImage && blogPost.data.featuredImage.length > 0;

  const allPostsForSidebar = await getCollection('blog');
  const sortedPosts = allPostsForSidebar.sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  allCategories = [
    { slug: 'edukasi', label: 'Edukasi', count: 0 },
    { slug: 'promosi', label: 'Promosi', count: 0 },
    { slug: 'tips-trik', label: 'Tips & Trik', count: 0 },
  ];
  allCategories.forEach((cat) => {
    cat.count = sortedPosts.filter((p: any) => p.data.category === cat.slug).length;
  });
  recentPosts = sortedPosts.slice(0, 5).map((p: any) => ({
    title: p.data.title,
    slug: p.data.slug,
    date: p.data.date,
  }));
}
---

<BaseLayout title={pageTitle} description={pageDescription} ogImage={pageOgImage}>
  <Layout>
    {isBlog && blogPost && (
      <article class="max-w-7xl mx-auto px-4 py-8">
        <Breadcrumb items={[
          { label: 'Beranda', href: '/' },
          { label: categoryLabel, href: `/berita/?category=${blogPost.data.category}` },
          { label: blogPost.data.title },
        ]} />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
          <div class="lg:col-span-8">
            <header class="mb-8">
              <h1 class="text-2xl md:text-4xl font-bold text-primary leading-tight mb-4">
                {blogPost.data.title}
              </h1>
              <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500">
                <time datetime={blogPost.data.date}>{formatDate(blogPost.data.date)}</time>
                <span class="text-gray-300">|</span>
                <span>{blogPost.data.author}</span>
                <span class="text-gray-300">|</span>
                <span class="bg-accent/10 text-accent text-xs font-semibold px-2.5 py-1 rounded-full">
                  {categoryLabel}
                </span>
              </div>
            </header>

            {hasFeaturedImage && (
              <div class="relative rounded-xl overflow-hidden mb-8 aspect-[16/9]">
                <div class="skeleton absolute inset-0 z-10"></div>
                <img
                  src={blogPost.data.featuredImage}
                  alt={blogPost.data.title}
                  class="w-full h-full object-cover opacity-0"
                  loading="lazy"
                  onload="this.style.opacity='1';this.previousElementSibling.style.display='none'"
                />
              </div>
            )}

            <div class="prose prose-lg max-w-none prose-headings:text-primary prose-headings:font-bold prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl">
              <Content />
            </div>

            {blogPost.data.tags && blogPost.data.tags.length > 0 && (
              <div class="mt-10 pt-8 border-t border-gray-100">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">Tags</h3>
                <div class="flex flex-wrap gap-2">
                  {blogPost.data.tags.map((tag: string) => (
                    <a
                      href={`/berita/?category=${tag}`}
                      class="px-3 py-1.5 text-sm text-gray-600 bg-gray-100 hover:bg-accent-50 hover:text-accent rounded-full transition-colors"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <div class="mt-10 p-8 bg-gradient-to-br from-primary to-primary-400 rounded-2xl text-white text-center">
              <h2 class="text-2xl font-bold mb-3">Butuh Jasa Pengiriman?</h2>
              <p class="text-white/80 mb-6 max-w-md mx-auto">
                Hubungi kami sekarang untuk konsultasi gratis dan dapatkan penawaran terbaik untuk kebutuhan pengiriman Anda.
              </p>
              <a
                href={SITE.whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-accent hover:bg-accent-600 text-white font-semibold px-8 py-3.5 rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Hubungi via WhatsApp
              </a>
            </div>
          </div>

          <Sidebar categories={allCategories} recentPosts={recentPosts} />
        </div>
      </article>
    )}

    {isSeo && (
      <article class="max-w-7xl mx-auto px-4 py-8">
        <Breadcrumb items={[
          { label: 'Beranda', href: '/' },
          { label: pageProps.city.cityName },
        ]} />

        <div class="max-w-4xl mx-auto mt-6">
          <header class="mb-8">
            <h1 class="text-2xl md:text-4xl font-bold text-primary leading-tight">
              {pageProps.city.title}
            </h1>
          </header>

          <div class="prose prose-lg max-w-none prose-headings:text-primary prose-headings:font-bold prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl" set:html={pageProps.city.content} />

          <div class="mt-12 p-8 bg-gradient-to-br from-primary to-primary-400 rounded-2xl text-white text-center">
            <h2 class="text-2xl font-bold mb-3">Butuh Jasa Pengiriman ke {pageProps.city.cityName}?</h2>
            <p class="text-white/80 mb-6 max-w-lg mx-auto">
              Hubungi kami sekarang untuk konsultasi gratis dan dapatkan penawaran terbaik untuk pengiriman Surabaya ke {pageProps.city.cityName}.
            </p>
            <a
              href={SITE.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-accent hover:bg-accent-600 text-white font-semibold px-8 py-3.5 rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Hubungi via WhatsApp
            </a>
          </div>
        </div>
      </article>
    )}
  </Layout>
  <WhatsAppButton />
</BaseLayout>
