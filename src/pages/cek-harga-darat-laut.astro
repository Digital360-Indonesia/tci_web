---
import BaseLayout from '../layouts/BaseLayout.astro';
import Layout from '../components/layout/Layout.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';
import { SITE } from '../data/company';
import data from '../data/harga-darat-laut.json';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Beranda", "item": SITE.url },
    { "@type": "ListItem", "position": 2, "name": "Cek Harga Darat & Laut" }
  ]
};
---

<BaseLayout title="Cek Harga Kargo Darat & Laut" description="Cek harga pengiriman kargo darat & laut dari Surabaya ke seluruh Indonesia. Kombinasi trucking dan kapal untuk efisiensi biaya. PT Terminal Cargo Indonesia." jsonLd={[breadcrumbSchema]}>
  <Layout>
    <section class="bg-[#021B43] py-16 sm:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">Cek Harga Darat & Laut</h1>
        <span class="inline-block bg-accent text-white text-sm font-semibold px-4 py-1.5 rounded-full">EFFECTIVE 2025 — Pulau Sumatera</span>
        <div class="mt-8 max-w-md mx-auto">
          <input id="searchInput" type="text" placeholder="Cari kota atau provinsi..." class="w-full px-5 py-3 rounded-lg bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#FF5001]" />
          <p id="resultCount" class="text-gray-300 text-sm mt-2 text-center hidden"></p>
        </div>
      </div>
    </section>

    <section class="bg-[#021B43] pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="overflow-x-auto rounded-xl shadow-2xl">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-[#FF5001] text-white">
                <th class="px-4 py-3 text-left font-semibold">No</th>
                <th class="px-4 py-3 text-left font-semibold">Provinsi</th>
                <th class="px-4 py-3 text-left font-semibold">Kota/Kabupaten</th>
                <th class="px-4 py-3 text-right font-semibold">Harga/Kg</th>
                <th class="px-4 py-3 text-center font-semibold">Min Charge</th>
                <th class="px-4 py-3 text-center font-semibold">Lead Time</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="bg-[#021B43]"></tbody>
          </table>
        </div>

        <div class="mt-10">
          <div class="border-l-4 border-accent bg-white/5 rounded-r-lg p-5">
            <h3 class="text-white font-bold text-lg mb-3">CATATAN PENTING</h3>
            <ul class="text-white space-y-1.5 text-sm list-disc list-inside">
              <li>Effective: <strong class="text-accent">2025</strong></li>
              <li>PPN: Harga belum termasuk PPN <strong class="text-accent">1.1%</strong></li>
              <li>Layanan <strong class="text-accent">Door to Door</strong></li>
              <li>Asuransi <strong class="text-accent">tidak termasuk</strong></li>
              <li>Update harga <strong class="text-accent">pending</strong></li>
              <li>Invoice maksimal <strong class="text-accent">7 hari</strong></li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </Layout>
  <WhatsAppButton />
</BaseLayout>

<script define:vars={{ data }}>
  function renderTable(items) {
    const tbody = document.getElementById('tableBody');
    const countEl = document.getElementById('resultCount');
    const total = data.length;

    if (items.length < total) {
      countEl.textContent = `Menampilkan ${items.length} dari ${total} kota`;
      countEl.classList.remove('hidden');
    } else {
      countEl.classList.add('hidden');
    }

    tbody.innerHTML = items.map((row, idx) => {
      const bg = idx % 2 === 0 ? 'bg-[#021B43]' : 'bg-[#0a2449]';
      const harga = row.harga !== null && row.harga !== undefined
        ? `<span class="text-green-400 font-bold">Rp ${row.harga.toLocaleString('id-ID')}</span>`
        : '<span class="text-gray-400">-</span>';
      const minCharge = row.min_charge !== null && row.min_charge !== undefined
        ? `<span class="text-white">${row.min_charge} Kg</span>`
        : '<span class="text-gray-400">-</span>';

      return `<tr class="${bg} hover:bg-white/10 transition-colors">
        <td class="px-4 py-2.5 text-gray-300">${idx + 1}</td>
        <td class="px-4 py-2.5"><span class="bg-blue-500 text-white text-xs font-semibold px-2.5 py-0.5 rounded-full">${row.provinsi}</span></td>
        <td class="px-4 py-2.5 text-white font-medium">${row.kota}</td>
        <td class="px-4 py-2.5 text-right">${harga}</td>
        <td class="px-4 py-2.5 text-center">${minCharge}</td>
        <td class="px-4 py-2.5 text-center"><span class="bg-cyan-500 text-white text-xs font-semibold px-2.5 py-0.5 rounded-full">${row.lead_time}</span></td>
      </tr>`;
    }).join('');
  }

  renderTable(data);

  document.getElementById('searchInput').addEventListener('input', function () {
    const q = this.value.toLowerCase().trim();
    const filtered = data.filter(r =>
      r.kota.toLowerCase().includes(q) || r.provinsi.toLowerCase().includes(q)
    );
    renderTable(filtered);
  });
</script>
