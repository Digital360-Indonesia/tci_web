---
import BaseLayout from '../layouts/BaseLayout.astro';
import Layout from '../components/layout/Layout.astro';
import Breadcrumb from '../components/shared/Breadcrumb.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';
import { SITE } from '../data/company';

const stats = [
  { value: `${new Date().getFullYear() - SITE.founded}+`, label: 'Tahun Pengalaman', icon: 'calendar' },
  { value: SITE.stats.shipments, label: 'Total Pengiriman', icon: 'box' },
  { value: SITE.stats.destinations, label: 'Kota Tujuan', icon: 'map' },
  { value: SITE.stats.partners, label: 'Maskapai Partner', icon: 'plane' },
];

const legalItems = [
  { label: 'Notaris', value: SITE.legal.notaris },
  { label: 'Nomor Akta', value: SITE.legal.nomor },
  { label: 'Pengesahan Kehakiman', value: SITE.legal.kehakiman },
  { label: 'TDP', value: SITE.legal.noTdp },
  { label: 'NPWP', value: SITE.legal.noNpwp },
  { label: 'SIUP', value: SITE.legal.noSiup },
];
---

<BaseLayout title="Tentang Kami — Terminal Cargo Indonesia" description="PT Terminal Cargo Indonesia (TCI) adalah perusahaan forwarding dan ekspedisi yang berbasis di Terminal Cargo T2 Bandara Juanda, Surabaya. Berpengalaman 10+ tahun.">
  <Layout>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

      <Breadcrumb items={[{ label: 'Tentang Kami' }]} />

      <!-- Hero Banner -->
      <div class="relative rounded-xl overflow-hidden mb-12">
        <img
          src="/images/tci_tentang_kami.png"
          alt="Tentang PT Terminal Cargo Indonesia"
          class="w-full h-64 sm:h-80 lg:h-[420px] object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#021B43]/90 via-[#021B43]/60 to-transparent"></div>
        <div class="absolute inset-0 flex items-center px-8 sm:px-12 lg:px-16">
          <div class="max-w-xl">
            <span class="inline-block text-accent uppercase tracking-[0.2em] text-xs sm:text-sm font-semibold mb-3">Est. 2014 — Surabaya</span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-4">Tentang Terminal Cargo Indonesia</h1>
            <p class="text-white/70 text-sm sm:text-base leading-relaxed max-w-md">Perusahaan forwarding dan ekspedisi terpercaya dari Surabaya ke seluruh Indonesia via Udara, Darat, dan Laut.</p>
          </div>
        </div>
      </div>

      <!-- Stats Bar -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-14">
        {stats.map((stat) => (
          <div class="bg-primary rounded-xl p-5 sm:p-6 text-center">
            <p class="text-2xl sm:text-3xl font-extrabold text-white leading-none">{stat.value}</p>
            <p class="text-white/50 text-xs uppercase tracking-wider mt-1.5">{stat.label}</p>
          </div>
        ))}
      </div>

      <!-- About Section: 2 Column -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-14 mb-16 items-start">
        <div class="lg:col-span-3">
          <span class="inline-block text-accent text-sm font-semibold uppercase tracking-wider mb-2">Siapa Kami</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#021B43] mb-6">PT Terminal Cargo Indonesia</h2>
          <div class="space-y-4 text-gray-700 leading-relaxed">
            <p>PT Terminal Cargo Indonesia (TCI) didirikan pada <strong>1 Agustus 2014</strong> sebagai perusahaan forwarding dan ekspedisi yang berbasis di Terminal Cargo T2 Bandara Juanda, Sidoarjo.</p>
            <p>TCI menyediakan jasa pengiriman barang <strong>Port to Port, Port to Door, Door to Door</strong>, serta <strong>Trucking</strong> dari Surabaya ke seluruh Indonesia melalui jalur Udara, Darat, dan Laut. Dengan pengalaman lebih dari 10 tahun, TCI berkomitmen memberikan layanan pengiriman yang handal, efisien, dan terjangkau.</p>
            <p>Dengan gudang sendiri di Terminal Cargo T2 Bandara Juanda dan kerjasama dengan <strong>7+ maskapai nasional</strong>, kami memiliki infrastruktur dan jaringan yang kuat untuk memastikan setiap kiriman sampai dengan aman dan tepat waktu.</p>
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="bg-gray-50 rounded-xl border border-gray-100 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-[#021B43] mb-5">Informasi Legalitas</h3>
            <div class="space-y-3">
              {legalItems.map((item) => (
                <div class="flex justify-between items-start gap-4 pb-3 border-b border-gray-200 last:border-0 last:pb-0">
                  <span class="text-gray-500 text-sm flex-shrink-0">{item.label}</span>
                  <span class="text-[#021B43] text-sm font-medium text-right">{item.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Visi & Misi: Side by Side -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
        <div class="bg-primary rounded-xl p-8 sm:p-10 text-white">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </div>
            <h2 class="text-2xl font-bold">Visi</h2>
          </div>
          <ul class="space-y-4">
            {SITE.vision.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-white/80 leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-50 rounded-xl p-8 sm:p-10 border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h2 class="text-2xl font-bold text-[#021B43]">Misi</h2>
          </div>
          <ol class="space-y-4">
            {SITE.mission.map((item, i) => (
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-accent/10 text-accent text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">{i + 1}</span>
                <span class="text-gray-700 leading-relaxed">{item}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <!-- Budaya Perusahaan -->
      <div class="mb-16">
        <div class="text-center mb-10">
          <span class="inline-block text-accent text-sm font-semibold uppercase tracking-wider mb-2">Budaya Kerja</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#021B43]">Nilai-Nilai Perusahaan</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {SITE.culture.map((item) => (
            <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm hover:shadow-lg hover:border-accent/30 transition-all duration-300 group">
              <div class="w-12 h-12 rounded-xl bg-accent/10 group-hover:bg-accent/20 flex items-center justify-center mb-4 transition-colors">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-[#021B43] mb-2">{item.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="bg-primary rounded-xl p-8 sm:p-12 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Siap mengirim barang dengan TCI?</h2>
        <p class="text-gray-300 mb-6 max-w-2xl mx-auto">Hubungi kami sekarang untuk konsultasi gratis dan dapatkan penawaran terbaik untuk kebutuhan pengiriman Anda.</p>
        <a
          href={SITE.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-accent hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-lg transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Hubungi Kami
        </a>
      </div>

    </div>
  </Layout>
  <WhatsAppButton />
</BaseLayout>
