---
import BaseLayout from '../layouts/BaseLayout.astro';
import Layout from '../components/layout/Layout.astro';
import Breadcrumb from '../components/shared/Breadcrumb.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';
import { SITE } from '../data/company';
---

<BaseLayout title="Hubungi Kami" description="Hubungi PT Terminal Cargo Indonesia di Bandara Juanda, Surabaya. Telepon (031) 5828-5034, WhatsApp 0812-5259-5159. Konsultasi gratis pengiriman barang." jsonLd={{ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Beranda", "item": SITE.url }, { "@type": "ListItem", "position": 2, "name": "Kontak" }] }}>
  <Layout>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

      <Breadcrumb items={[{ label: 'Kontak' }]} />

      <h1 class="text-3xl sm:text-4xl font-bold text-[#021B43] mb-10">Kontak Kami</h1>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 flex flex-col items-center text-center">
          <div class="w-14 h-14 bg-[#021B43] rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-[#021B43] mb-2">Lokasi</h3>
          <p class="text-gray-600">{SITE.address}</p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 flex flex-col items-center text-center">
          <div class="w-14 h-14 bg-[#021B43] rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-[#021B43] mb-2">Telepon</h3>
          <p class="text-gray-600">{SITE.phone}</p>
          <p class="text-gray-600">{SITE.phoneAlt}</p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 flex flex-col items-center text-center">
          <div class="w-14 h-14 bg-[#021B43] rounded-full flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-[#021B43] mb-2">Email</h3>
          <p class="text-gray-600">{SITE.email}</p>
          <p class="text-gray-600">{SITE.emailAlt}</p>
        </div>
      </div>

      <div class="mb-12">
        <h2 class="text-2xl font-bold text-[#021B43] mb-4">Lokasi Kami</h2>
        <div class="rounded-xl overflow-hidden shadow-md">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3956.0!2d112.7703073!3d-7.3816923!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd7e539895ec851%3A0x9cec20c32e8fe0e0!2sPT%20Terminal%20Cargo%20Indonesia!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Lokasi PT Terminal Cargo Indonesia"
          ></iframe>
        </div>
      </div>

      <div class="bg-[#021B43] rounded-xl p-8 sm:p-12 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Konsultasikan Kebutuhan Anda</h2>
        <p class="text-gray-300 mb-6 max-w-2xl mx-auto">Hubungi kami melalui WhatsApp untuk konsultasi pengiriman barang ke seluruh Indonesia.</p>
        <a
          href={SITE.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#FF5001] hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-lg transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Hubungi via WhatsApp
        </a>
      </div>

    </div>
  </Layout>
  <WhatsAppButton />
</BaseLayout>
