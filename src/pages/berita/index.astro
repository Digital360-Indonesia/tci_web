---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Layout from '../../components/layout/Layout.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import Sidebar from '../../components/blog/Sidebar.astro';
import WhatsAppButton from '../../components/shared/WhatsAppButton.astro';
import { SITE } from '../../data/company';
import { getCollection } from 'astro:content';

const POSTS_PER_PAGE = 9;

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allCategories = [
  { slug: 'edukasi', label: 'Edukasi', count: 0 },
  { slug: 'promosi', label: 'Promosi', count: 0 },
  { slug: 'tips-trik', label: 'Tips & Trik', count: 0 },
];
allCategories.forEach((cat) => {
  cat.count = sortedPosts.filter((p) => p.data.category === cat.slug).length;
});

const recentPosts = sortedPosts.slice(0, 5).map((p) => ({
  title: p.data.title,
  slug: p.data.slug,
  date: p.data.date,
}));

const categoryFilter = [
  { slug: '', label: 'Semua' },
  ...allCategories,
];

const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Beranda", "item": SITE.url },
    { "@type": "ListItem", "position": 2, "name": "Berita" }
  ]
};

// Pass data to client-side as JSON
const postsData = sortedPosts.map((p) => ({
  title: p.data.title,
  slug: p.data.slug,
  excerpt: p.data.excerpt,
  date: p.data.date,
  category: p.data.category,
  featuredImage: p.data.featuredImage,
  ogImage: p.data.ogImage,
  author: p.data.author,
}));
---

<BaseLayout
  title="Blog Berita & Artikel Logistik"
  description="Berita dan artikel terbaru seputar logistik, pengiriman barang, tips ekspedisi, dan panduan cargo dari Terminal Cargo Indonesia. Informasi udara, darat & laut."
  jsonLd={[breadcrumbSchema]}
>
  <Layout>
    <div class="max-w-7xl mx-auto px-4 py-8">
      <Breadcrumb items={[
        { label: 'Beranda', href: '/' },
        { label: 'Berita Terbaru' },
      ]} />

      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-primary">Berita Terbaru</h1>
        <p class="text-gray-500 mt-2">Informasi dan artikel seputar logistik, pengiriman barang, dan tips ekspedisi.</p>
      </div>

      <div class="flex flex-wrap gap-2 mb-8" id="category-filter">
        {categoryFilter.map((cat) => (
          <a
            href={cat.slug ? `/berita/?category=${cat.slug}` : '/berita/'}
            class="category-pill px-4 py-2 text-sm font-medium rounded-full border transition-colors border-gray-200 text-gray-600 hover:border-accent hover:text-accent"
            data-category={cat.slug}
          >
            {cat.label}
            {cat.slug && (
              <span class="ml-1 text-xs text-gray-400">({cat.count})</span>
            )}
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6" id="articles-grid">
            {/* Skeleton placeholders — shown during initial load & transitions */}
            {Array.from({ length: 9 }, (_, i) => (
              <div class="skel-card" id={`skel-${i}`}>
                <div class="bg-white rounded-xl overflow-hidden shadow-md">
                  <div class="skeleton aspect-[16/10]"></div>
                  <div class="p-5 space-y-3">
                    <div class="skeleton h-5 w-3/4 rounded"></div>
                    <div class="space-y-2">
                      <div class="skeleton h-3 w-full rounded"></div>
                      <div class="skeleton h-3 w-5/6 rounded"></div>
                      <div class="skeleton h-3 w-2/3 rounded"></div>
                    </div>
                    <div class="flex justify-between">
                      <div class="skeleton h-3 w-20 rounded"></div>
                      <div class="skeleton h-3 w-16 rounded"></div>
                    </div>
                  </div>
                </div>
              </div>
            ))}

            {/* Actual articles — hidden by default, shown after JS init */}
            {sortedPosts.map((post) => (
              <div
                class="article-item"
                style="display:none"
                data-category={post.data.category}
                data-title={post.data.title.toLowerCase()}
              >
                <ArticleCard
                  title={post.data.title}
                  slug={post.data.slug}
                  excerpt={post.data.excerpt}
                  date={post.data.date}
                  category={post.data.category}
                  featuredImage={post.data.featuredImage}
                  ogImage={post.data.ogImage}
                  author={post.data.author}
                />
              </div>
            ))}
          </div>

          <!-- Client-side pagination -->
          <nav aria-label="Pagination" class="flex items-center justify-center gap-1.5 mt-10" id="pagination-nav"></nav>
        </div>

        <Sidebar categories={allCategories} recentPosts={recentPosts} />
      </div>
    </div>
  </Layout>
  <WhatsAppButton />
</BaseLayout>

<script define:vars={{ postsPerPage: 9, totalPages }}>
  const grid = document.getElementById('articles-grid');
  const nav = document.getElementById('pagination-nav');
  const allItems = Array.from(document.querySelectorAll('.article-item'));
  const skelCards = Array.from(document.querySelectorAll('.skel-card'));
  let activeCategory = '';
  let currentPage = 1;

  // ── Skeleton helpers ──
  function showSkeleton(count) {
    skelCards.forEach((s, i) => { s.style.display = i < count ? '' : 'none'; });
    allItems.forEach((item) => { item.style.display = 'none'; });
  }

  function hideSkeleton() {
    skelCards.forEach((s) => { s.style.display = 'none'; });
  }

  function getFilteredItems() {
    if (!activeCategory) return allItems;
    return allItems.filter((item) => item.dataset.category === activeCategory);
  }

  function getTotalPages(items) {
    return Math.max(1, Math.ceil(items.length / postsPerPage));
  }

  function renderPage(instant) {
    const filtered = getFilteredItems();
    const total = getTotalPages(filtered);

    if (currentPage > total) currentPage = total;
    if (currentPage < 1) currentPage = 1;

    const start = (currentPage - 1) * postsPerPage;
    const pageItems = filtered.slice(start, start + postsPerPage);

    if (instant) {
      // No skeleton, show immediately
      hideSkeleton();
      const visibleSet = new Set(pageItems);
      allItems.forEach((item) => {
        const matchCat = !activeCategory || item.dataset.category === activeCategory;
        item.style.display = (matchCat && visibleSet.has(item)) ? '' : 'none';
      });
      renderPagination(total);
    } else {
      // Show skeleton briefly for transition
      showSkeleton(Math.min(postsPerPage, filtered.length));
      setTimeout(() => {
        hideSkeleton();
        const visibleSet = new Set(pageItems);
        allItems.forEach((item) => {
          const matchCat = !activeCategory || item.dataset.category === activeCategory;
          item.style.display = (matchCat && visibleSet.has(item)) ? '' : 'none';
        });
        renderPagination(total);
      }, 300);
    }

    // Update URL
    const url = new URL(window.location.href);
    if (activeCategory) url.searchParams.set('category', activeCategory);
    else url.searchParams.delete('category');
    if (currentPage > 1) url.searchParams.set('page', String(currentPage));
    else url.searchParams.delete('page');
    history.replaceState(null, '', url.toString());
  }

  function renderPagination(total) {
    if (!nav) return;
    if (total <= 1) { nav.innerHTML = ''; return; }

    let html = '';

    // Prev
    html += currentPage > 1
      ? `<button class="pg-btn flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-600 hover:text-accent hover:bg-accent-50 rounded-lg transition-colors" data-page="${currentPage - 1}"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg><span class="hidden sm:inline">Sebelumnya</span></button>`
      : `<span class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-300 cursor-not-allowed"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg><span class="hidden sm:inline">Sebelumnya</span></span>`;

    // Pages
    const pages = [];
    if (total <= 7) {
      for (let i = 1; i <= total; i++) pages.push(i);
    } else {
      pages.push(1);
      if (currentPage > 3) pages.push('...');
      for (let i = Math.max(2, currentPage - 1); i <= Math.min(total - 1, currentPage + 1); i++) pages.push(i);
      if (currentPage < total - 2) pages.push('...');
      pages.push(total);
    }

    html += '<div class="flex items-center gap-1">';
    for (const p of pages) {
      if (p === '...') {
        html += '<span class="px-2 py-2 text-gray-400 text-sm">&hellip;</span>';
      } else if (p === currentPage) {
        html += `<span class="min-w-[36px] h-9 flex items-center justify-center text-sm font-medium rounded-lg bg-accent text-white shadow-md">${p}</span>`;
      } else {
        html += `<button class="pg-btn min-w-[36px] h-9 flex items-center justify-center text-sm font-medium rounded-lg text-gray-600 hover:text-accent hover:bg-accent-50 transition-colors" data-page="${p}">${p}</button>`;
      }
    }
    html += '</div>';

    // Next
    html += currentPage < total
      ? `<button class="pg-btn flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-600 hover:text-accent hover:bg-accent-50 rounded-lg transition-colors" data-page="${currentPage + 1}"><span class="hidden sm:inline">Selanjutnya</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></button>`
      : `<span class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-300 cursor-not-allowed"><span class="hidden sm:inline">Selanjutnya</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>`;

    nav.innerHTML = html;

    // Pagination button events
    nav.querySelectorAll('.pg-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const page = parseInt(btn.dataset.page || '1', 10);
        if (page !== currentPage) {
          currentPage = page;
          renderPage(false);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });
  }

  // ── Category pills ──
  function setActivePill(cat) {
    document.querySelectorAll('.category-pill').forEach((p) => {
      const pCat = p.dataset.category || '';
      if (pCat === cat) {
        p.classList.add('bg-accent', 'text-white', 'border-accent');
        p.classList.remove('text-gray-600', 'border-gray-200');
      } else {
        p.classList.remove('bg-accent', 'text-white', 'border-accent');
        p.classList.add('text-gray-600', 'border-gray-200');
      }
    });
  }

  document.querySelectorAll('.category-pill').forEach((pill) => {
    pill.addEventListener('click', (e) => {
      e.preventDefault();
      activeCategory = pill.dataset.category || '';
      currentPage = 1;
      setActivePill(activeCategory);
      renderPage(false);
    });
  });

  // ── Search ──
  function initSearch(inputId) {
    const input = document.getElementById(inputId);
    if (!input) return;
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      allItems.forEach((item) => {
        const title = (item.dataset.title || '').toLowerCase();
        const matchCat = !activeCategory || item.dataset.category === activeCategory;
        item.dataset.searchMatch = String(!q || title.includes(q));
      });
      currentPage = 1;
      renderPageWithSearch();
    });
  }

  function renderPageWithSearch() {
    const filtered = getFilteredItems().filter((item) => item.dataset.searchMatch !== 'false');
    const total = getTotalPages(filtered);
    if (currentPage > total) currentPage = total;
    const start = (currentPage - 1) * postsPerPage;
    const pageItems = filtered.slice(start, start + postsPerPage);

    showSkeleton(Math.min(postsPerPage, filtered.length));
    setTimeout(() => {
      hideSkeleton();
      const visibleSet = new Set(pageItems);
      allItems.forEach((item) => {
        const matchCat = !activeCategory || item.dataset.category === activeCategory;
        const matchSearch = item.dataset.searchMatch !== 'false';
        item.style.display = (matchCat && matchSearch && visibleSet.has(item)) ? '' : 'none';
      });
      renderPagination(total);
    }, 200);
  }

  initSearch('blog-search');
  initSearch('blog-search-mobile');

  // ── Init from URL ──
  const params = new URLSearchParams(window.location.search);
  const urlCat = params.get('category');
  if (urlCat) {
    activeCategory = urlCat;
    setActivePill(urlCat);
  }
  const urlPage = parseInt(params.get('page') || '1', 10);
  currentPage = urlPage;
  // Initial render with skeleton, then reveal
  setTimeout(() => { renderPage(true); }, 400);
</script>
