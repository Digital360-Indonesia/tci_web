---
import BaseLayout from '../layouts/BaseLayout.astro';
import Layout from '../components/layout/Layout.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';
import data from '../data/harga-ptp.json';
---

<BaseLayout title="Cek Harga Udara (Port to Port) — Terminal Cargo Indonesia">
  <Layout>
    <section class="bg-[#021B43] py-16 sm:py-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">Cek Harga Udara (Port to Port)</h1>
        <span class="inline-block bg-accent text-white text-sm font-semibold px-4 py-1.5 rounded-full">EFFECTIVE 1 NOV 2025</span>
        <div class="mt-8 max-w-md mx-auto">
          <input id="searchInput" type="text" placeholder="Cari kota atau kode..." class="w-full px-5 py-3 rounded-lg bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#FF5001]" />
          <p id="resultCount" class="text-gray-300 text-sm mt-2 text-center hidden"></p>
        </div>
      </div>
    </section>

    <section class="bg-[#021B43] pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="overflow-x-auto rounded-xl shadow-2xl">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-[#FF5001] text-white">
                <th class="px-4 py-3 text-left font-semibold">No</th>
                <th class="px-4 py-3 text-left font-semibold">Kota Tujuan</th>
                <th class="px-4 py-3 text-center font-semibold">Code</th>
                <th class="px-4 py-3 text-right font-semibold">Garuda</th>
                <th class="px-4 py-3 text-right font-semibold">Sriwijaya</th>
                <th class="px-4 py-3 text-right font-semibold">Lion</th>
                <th class="px-4 py-3 text-right font-semibold">Citilink</th>
                <th class="px-4 py-3 text-center font-semibold">Lead Time</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="bg-[#021B43]"></tbody>
          </table>
        </div>

        <div class="mt-10 space-y-6">
          <div class="border-l-4 border-accent bg-white/5 rounded-r-lg p-5">
            <h3 class="text-white font-bold text-lg mb-3">CATATAN PENTING</h3>
            <ul class="text-white space-y-1.5 text-sm list-disc list-inside">
              <li>Effective: <strong class="text-accent">1 November 2025</strong></li>
              <li>Biaya Admin: <strong class="text-accent">Rp 30.000 / SMU</strong> (belum termasuk)</li>
              <li>Lion CGK: Sudah termasuk tambahan biaya INC</li>
              <li>PPN: Harga belum termasuk PPN <strong class="text-accent">1.1%</strong></li>
              <li>Minimum Charge: <strong class="text-accent">10 kg/coli</strong></li>
              <li>Void SMU: <strong class="text-accent">Rp 25.000 / SMU</strong></li>
              <li>Dangerous Goods: <strong class="text-accent">Tidak menerima shipment dangerous goods</strong></li>
              <li>Lead Time: Tidak berlaku untuk kondisi <strong class="text-accent">peak season</strong></li>
            </ul>
          </div>

          <div class="border-l-4 border-yellow-400 bg-yellow-900/20 rounded-r-lg p-5">
            <h3 class="text-white font-bold text-lg mb-3">SURCHARGE OVERWEIGHT</h3>
            <div class="text-white text-sm space-y-1.5">
              <p><strong>Garuda:</strong> 70–99kg (200%), 100–149kg (200%), 150–250kg (200%)</p>
              <p><strong>Lion Air:</strong> 70–99kg (50%), 100–149kg (100%), 150–200kg (200%)</p>
              <p><strong>Sriwijaya:</strong> 100–200kg (100%)</p>
              <p><strong>Citilink:</strong> 70–150kg (100%)</p>
            </div>
          </div>

          <div class="border-l-4 border-green-500 bg-green-900/20 rounded-r-lg p-5">
            <h3 class="text-white font-bold text-lg mb-3">LIVE ANIMAL & LIVE TUMBUHAN</h3>
            <p class="text-white text-sm">Surcharge <strong class="text-accent">150%</strong> + Harga (Garuda)</p>
          </div>
        </div>
      </div>
    </section>
  </Layout>
  <WhatsAppButton />
</BaseLayout>

<script define:vars={{ data }}>
  function renderTable(items) {
    const tbody = document.getElementById('tableBody');
    const countEl = document.getElementById('resultCount');
    const total = data.length;

    if (items.length < total) {
      countEl.textContent = `Menampilkan ${items.length} dari ${total} kota`;
      countEl.classList.remove('hidden');
    } else {
      countEl.classList.add('hidden');
    }

    tbody.innerHTML = items.map((row, idx) => {
      const bg = idx % 2 === 0 ? 'bg-[#021B43]' : 'bg-[#0a2449]';

      return `<tr class="${bg} hover:bg-white/10 transition-colors">
        <td class="px-4 py-2.5 text-gray-300">${idx + 1}</td>
        <td class="px-4 py-2.5 text-white font-medium">${row.kota}</td>
        <td class="px-4 py-2.5 text-center"><span class="bg-accent text-white text-xs font-bold px-2 py-0.5 rounded">${row.code}</span></td>
        <td class="px-4 py-2.5 text-right">${row.garuda !== null ? '<span class="text-blue-400 font-bold">Rp ' + row.garuda.toLocaleString('id-ID') + '</span>' : '<span class="text-gray-500">-</span>'}</td>
        <td class="px-4 py-2.5 text-right">${row.sriwijaya !== null ? '<span class="text-green-400 font-bold">Rp ' + row.sriwijaya.toLocaleString('id-ID') + '</span>' : '<span class="text-gray-500">-</span>'}</td>
        <td class="px-4 py-2.5 text-right">${row.lion !== null ? '<span class="text-red-400 font-bold">Rp ' + row.lion.toLocaleString('id-ID') + '</span>' : '<span class="text-gray-500">-</span>'}</td>
        <td class="px-4 py-2.5 text-right">${row.citilink !== null ? '<span class="text-purple-400 font-bold">Rp ' + row.citilink.toLocaleString('id-ID') + '</span>' : '<span class="text-gray-500">-</span>'}</td>
        <td class="px-4 py-2.5 text-center"><span class="bg-cyan-600 text-white text-xs font-semibold px-2 py-0.5 rounded">${row.lead_time}</span></td>
      </tr>`;
    }).join('');
  }

  renderTable(data);

  document.getElementById('searchInput').addEventListener('input', function () {
    const q = this.value.toLowerCase().trim();
    const filtered = data.filter(r =>
      r.kota.toLowerCase().includes(q) || r.code.toLowerCase().includes(q)
    );
    renderTable(filtered);
  });
</script>
