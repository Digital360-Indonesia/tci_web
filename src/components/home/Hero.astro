---
import { SITE } from '../../data/company';
---

<section class="hero-full relative flex flex-col bg-primary overflow-hidden">
  <!-- Logistics background -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">

    <!-- Gradient wash -->
    <div class="absolute top-0 right-0 w-[50%] h-full bg-gradient-to-bl from-accent/[0.06] via-transparent to-transparent"></div>

    <!-- SVG Route Network -->
    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <defs>
        <!-- Flight path for plane to follow -->
        <path id="flightPath" d="M200 700 Q600 100 1200 300"/>
        <path id="flightPath2" d="M100 800 Q500 200 1300 150"/>
      </defs>

      <!-- Flight route curves (air) -->
      <path d="M200 700 Q600 100 1200 300" stroke="rgba(255,80,1,0.08)" stroke-width="1.5" stroke-dasharray="8 6"/>
      <path d="M100 800 Q500 200 1300 150" stroke="rgba(255,80,1,0.06)" stroke-width="1" stroke-dasharray="6 8"/>
      <path d="M350 850 Q700 300 1250 500" stroke="rgba(255,255,255,0.04)" stroke-width="1" stroke-dasharray="4 10"/>
      <path d="M0 150 Q400 50 800 200 Q1100 320 1440 100" stroke="rgba(255,80,1,0.04)" stroke-width="1" stroke-dasharray="5 8"/>

      <!-- Sea route waves -->
      <path d="M0 600 Q200 580 400 600 Q600 620 800 600 Q1000 580 1200 600 Q1400 620 1440 600" stroke="rgba(255,255,255,0.06)" stroke-width="1.5"/>
      <path d="M0 650 Q200 630 400 650 Q600 670 800 650 Q1000 630 1200 650 Q1400 670 1440 650" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>

      <!-- Land route (straight dashed) -->
      <line x1="0" y1="500" x2="1440" y2="500" stroke="rgba(255,255,255,0.05)" stroke-width="1" stroke-dasharray="12 8"/>
      <line x1="0" y1="530" x2="1440" y2="530" stroke="rgba(255,255,255,0.03)" stroke-width="1" stroke-dasharray="8 12"/>

      <!-- Network nodes (cities) -->
      <circle cx="200" cy="700" r="4" fill="rgba(255,80,1,0.15)"/>
      <circle cx="200" cy="700" r="8" stroke="rgba(255,80,1,0.1)" stroke-width="1" fill="none"/>
      <circle cx="600" cy="300" r="3" fill="rgba(255,255,255,0.1)"/>
      <circle cx="600" cy="300" r="7" stroke="rgba(255,255,255,0.06)" stroke-width="1" fill="none"/>
      <circle cx="900" cy="200" r="3" fill="rgba(255,255,255,0.08)"/>
      <circle cx="1100" cy="350" r="3" fill="rgba(255,80,1,0.12)"/>
      <circle cx="1100" cy="350" r="6" stroke="rgba(255,80,1,0.08)" stroke-width="1" fill="none"/>
      <circle cx="1300" cy="150" r="4" fill="rgba(255,80,1,0.15)"/>
      <circle cx="1300" cy="150" r="8" stroke="rgba(255,80,1,0.1)" stroke-width="1" fill="none"/>
      <circle cx="500" cy="500" r="2" fill="rgba(255,255,255,0.08)"/>
      <circle cx="800" cy="450" r="2" fill="rgba(255,255,255,0.06)"/>
      <circle cx="1000" cy="550" r="2" fill="rgba(255,255,255,0.08)"/>
      <circle cx="350" cy="400" r="2.5" fill="rgba(255,255,255,0.1)"/>

      <!-- Connecting lines -->
      <line x1="200" y1="700" x2="600" y2="300" stroke="rgba(255,80,1,0.06)" stroke-width="0.5" stroke-dasharray="4 6"/>
      <line x1="600" y1="300" x2="900" y2="200" stroke="rgba(255,255,255,0.04)" stroke-width="0.5" stroke-dasharray="4 6"/>
      <line x1="900" y1="200" x2="1100" y2="350" stroke="rgba(255,255,255,0.04)" stroke-width="0.5" stroke-dasharray="4 6"/>
      <line x1="1100" y1="350" x2="1300" y2="150" stroke="rgba(255,80,1,0.06)" stroke-width="0.5" stroke-dasharray="4 6"/>

      <!-- ✈ PLANE 1 — main route, orange -->
      <g class="hero-plane-1">
        <g fill="#FF5001">
          <rect x="-12" y="-2" width="24" height="4" rx="2"/>
          <path d="M-2-2 L-8-10 L2-10 L2-2 Z"/>
          <path d="M-2 2 L-8 10 L2 10 L2 2 Z"/>
          <path d="M-12-2 L-16-7 L-10-7 L-10-2 Z"/>
          <circle cx="14" cy="0" r="2" opacity="0.5"/>
        </g>
      </g>

      <!-- ✈ PLANE 2 — second route, white, delayed -->
      <g class="hero-plane-2">
        <g fill="white">
          <rect x="-9" y="-1.5" width="18" height="3" rx="1.5"/>
          <path d="M-1.5-1.5 L-6-7 L1.5-7 L1.5-1.5 Z"/>
          <path d="M-1.5 1.5 L-6 7 L1.5 7 L1.5 1.5 Z"/>
          <path d="M-9-1.5 L-12-5 L-7-5 L-7-1.5 Z"/>
        </g>
      </g>

      <!-- ✈ PLANE 3 — third route, orange, small -->
      <g class="hero-plane-3">
        <g fill="#FF5001">
          <rect x="-7" y="-1.2" width="14" height="2.4" rx="1.2"/>
          <path d="M-1-1.2 L-5-6 L1.5-6 L1.5-1.2 Z"/>
          <path d="M-1 1.2 L-5 6 L1.5 6 L1.5 1.2 Z"/>
          <path d="M-7-1.2 L-9.5-4 L-5.5-4 L-5.5-1.2 Z"/>
        </g>
      </g>

      <!-- ✈ PLANE 4 — high route, white, tiny -->
      <g class="hero-plane-4">
        <g fill="white">
          <rect x="-5" y="-1" width="10" height="2" rx="1"/>
          <path d="M-0.8-1 L-3.5-4.5 L1.2-4.5 L1.2-1 Z"/>
          <path d="M-0.8 1 L-3.5 4.5 L1.2 4.5 L1.2 1 Z"/>
        </g>
      </g>

      <!-- 🚢 SHIP 1 — main sea route -->
      <g class="hero-ship-1">
        <g fill="white">
          <path d="M-16 3 Q-14-2 0-2 Q14-2 16 3 Q10 7 -10 7 Z"/>
          <rect x="-4" y="-8" width="8" height="6" rx="1"/>
          <line x1="0" y1="-8" x2="0" y2="-22" stroke="white" stroke-width="1.5"/>
          <path d="M0-22 L12-12 L0-8 Z" opacity="0.5"/>
          <path d="M0-22 L6-20 L0-18" fill="#FF5001"/>
          <path d="M-20 7 Q-30 9 -40 7" stroke="white" stroke-width="0.8" opacity="0.3" fill="none"/>
          <path d="M-18 9 Q-26 11 -34 9" stroke="white" stroke-width="0.5" opacity="0.2" fill="none"/>
        </g>
      </g>

      <!-- 🚢 SHIP 2 — lower sea route, smaller -->
      <g class="hero-ship-2">
        <g fill="white">
          <path d="M-10 2 Q-9-1 0-1 Q9-1 10 2 Q6 5 -6 5 Z"/>
          <rect x="-2.5" y="-5" width="5" height="4" rx="0.5"/>
          <line x1="0" y1="-5" x2="0" y2="-14" stroke="white" stroke-width="1"/>
          <path d="M0-14 L8-8 L0-5 Z" opacity="0.4"/>
          <path d="M-14 5 Q-22 7 -28 5" stroke="white" stroke-width="0.5" opacity="0.2" fill="none"/>
        </g>
      </g>

      <!-- 🚛 TRUCK 1 — main land route -->
      <g class="hero-truck-1">
        <g fill="white">
          <rect x="-22" y="-10" width="24" height="12" rx="1.5"/>
          <rect x="2" y="-14" width="12" height="16" rx="2"/>
          <rect x="6" y="-12" width="6" height="6" rx="1" fill="rgba(255,80,1,0.3)"/>
          <circle cx="-14" cy="4" r="3" fill="rgba(2,27,67,0.5)" stroke="white" stroke-width="1.2"/>
          <circle cx="-4" cy="4" r="3" fill="rgba(2,27,67,0.5)" stroke="white" stroke-width="1.2"/>
          <circle cx="8" cy="4" r="3" fill="rgba(2,27,67,0.5)" stroke="white" stroke-width="1.2"/>
          <circle cx="-24" cy="-4" r="1.5" opacity="0.15"/>
          <circle cx="-28" cy="-6" r="2" opacity="0.08"/>
          <circle cx="-33" cy="-8" r="2.5" opacity="0.04"/>
        </g>
      </g>

      <!-- 🚛 TRUCK 2 — upper land route, smaller van -->
      <g class="hero-truck-2">
        <g fill="white">
          <rect x="-12" y="-8" width="14" height="10" rx="1"/>
          <rect x="2" y="-10" width="8" height="12" rx="1.5"/>
          <rect x="5" y="-8" width="4" height="4" rx="0.5" fill="rgba(255,80,1,0.2)"/>
          <circle cx="-7" cy="4" r="2.5" fill="rgba(2,27,67,0.5)" stroke="white" stroke-width="1"/>
          <circle cx="6" cy="4" r="2.5" fill="rgba(2,27,67,0.5)" stroke="white" stroke-width="1"/>
        </g>
      </g>

      <!-- 🚛 TRUCK 3 — pickup, smallest -->
      <g class="hero-truck-3">
        <g fill="white">
          <rect x="-8" y="-6" width="10" height="7" rx="0.5"/>
          <rect x="2" y="-8" width="6" height="9" rx="1"/>
          <rect x="4" y="-6.5" width="3" height="3" rx="0.5" fill="rgba(255,80,1,0.2)"/>
          <circle cx="-4" cy="3" r="2" fill="rgba(2,27,67,0.5)" stroke="white" stroke-width="0.8"/>
          <circle cx="5" cy="3" r="2" fill="rgba(2,27,67,0.5)" stroke="white" stroke-width="0.8"/>
        </g>
      </g>
    </svg>

    <!-- Subtle grid overlay -->
    <div class="absolute inset-0 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 80px 80px;"></div>
  </div>

  <!-- Main content -->
  <div class="relative z-10 flex-1 flex items-end pb-0">
    <div class="max-w-7xl mx-auto px-4 md:px-8 w-full py-12 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">

        <!-- Left-bottom: Headline + CTA -->
        <div class="lg:col-span-7">
          <span class="inline-block text-accent uppercase tracking-[0.3em] text-xs md:text-sm font-semibold mb-4 md:mb-6">
            Est. 2014 — Surabaya
          </span>

          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-[5.5rem] font-extrabold text-white leading-[1.05] mb-5 md:mb-7">
            Jasa Cargo Udara<br/>
            <span class="text-accent">Termurah</span> di Indonesia
          </h1>

          <p class="text-white/50 text-sm md:text-base leading-relaxed mb-8 max-w-lg">
            Pengiriman barang via Udara, Laut &amp; Darat. Layanan Port to Port, Door to Door &amp; Trucking dari Surabaya ke seluruh Indonesia.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={SITE.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Hubungi Kami
            </a>

            <a href="/cek-resi/" class="btn-outline">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Cek Resi
            </a>
          </div>
        </div>

        <!-- Right-top: Stats -->
        <div class="lg:col-span-5 grid grid-cols-2 lg:grid-cols-1 gap-3 lg:gap-4 justify-end">
          <div class="border-l-2 border-accent/40 pl-3 sm:pl-5 py-0.5 sm:py-1">
            <p class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-none">100k<span class="text-accent">+</span></p>
            <p class="text-white/40 text-[10px] sm:text-xs uppercase tracking-wider mt-0.5 sm:mt-1">Total Pengiriman</p>
          </div>
          <div class="border-l-2 border-white/10 pl-3 sm:pl-5 py-0.5 sm:py-1">
            <p class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-none">500<span class="text-accent">+</span></p>
            <p class="text-white/40 text-[10px] sm:text-xs uppercase tracking-wider mt-0.5 sm:mt-1">Kota Tujuan</p>
          </div>
          <div class="border-l-2 border-white/10 pl-3 sm:pl-5 py-0.5 sm:py-1">
            <p class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-none">97<span class="text-accent">%</span></p>
            <p class="text-white/40 text-[10px] sm:text-xs uppercase tracking-wider mt-0.5 sm:mt-1">Kepuasan Pelanggan</p>
          </div>
          <div class="border-l-2 border-white/10 pl-3 sm:pl-5 py-0.5 sm:py-1">
            <p class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-none">10<span class="text-accent">+</span></p>
            <p class="text-white/40 text-[10px] sm:text-xs uppercase tracking-wider mt-0.5 sm:mt-1">Tahun Pengalaman</p>
          </div>
          <div class="border-l-2 border-white/10 pl-3 sm:pl-5 py-0.5 sm:py-1 col-span-2 lg:col-span-1">
            <p class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-none">7<span class="text-accent">+</span></p>
            <p class="text-white/40 text-[10px] sm:text-xs uppercase tracking-wider mt-0.5 sm:mt-1">Maskapai Partner</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Marquee — included in 100vh -->
  <div class="relative z-10 border-t border-white/10 bg-white/[0.03] shrink-0">
    <div class="marquee-container overflow-hidden py-4">
      <div class="marquee-track flex whitespace-nowrap">
        {Array(2).fill(null).map(() => (
          <div class="marquee-content flex items-center gap-8 text-sm font-medium text-white/40 uppercase tracking-widest px-4">
            <span>Kargo Udara</span>
            <span class="text-accent">✦</span>
            <span>Kargo Laut</span>
            <span class="text-accent">✦</span>
            <span>Kargo Darat</span>
            <span class="text-accent">✦</span>
            <span>Port to Port</span>
            <span class="text-accent">✦</span>
            <span>Door to Door</span>
            <span class="text-accent">✦</span>
            <span>Trucking</span>
            <span class="text-accent">✦</span>
            <span>Surabaya ke Seluruh Indonesia</span>
            <span class="text-accent">✦</span>
            <span>Terpercaya Sejak 2014</span>
            <span class="text-accent">✦</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Navbar: mobile h-16=64px, desktop topbar h-10+nav h-20=120px */
  .hero-full {
    height: calc(100vh - 64px);
  }

  @media (min-width: 1024px) {
    .hero-full {
      height: calc(100vh - 120px);
    }
  }

  /* ✈ Plane 1 — main flight curve */
  .hero-plane-1 {
    offset-path: path('M200 700 Q600 100 1200 300');
    animation: flyRoute1 18s linear infinite;
  }
  @keyframes flyRoute1 {
    0% { offset-distance: 0%; opacity: 0; }
    5% { opacity: 0.6; }
    90% { opacity: 0.6; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* ✈ Plane 2 — second flight curve, staggered */
  .hero-plane-2 {
    offset-path: path('M100 800 Q500 200 1300 150');
    animation: flyRoute2 22s linear infinite;
    animation-delay: -8s;
  }
  @keyframes flyRoute2 {
    0% { offset-distance: 0%; opacity: 0; }
    5% { opacity: 0.45; }
    90% { opacity: 0.45; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* ✈ Plane 3 — third flight curve, orange, small */
  .hero-plane-3 {
    offset-path: path('M350 850 Q700 300 1250 500');
    animation: flyRoute3 25s linear infinite;
    animation-delay: -3s;
  }
  @keyframes flyRoute3 {
    0% { offset-distance: 0%; opacity: 0; }
    5% { opacity: 0.4; }
    90% { opacity: 0.4; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* ✈ Plane 4 — high fast route, tiny */
  .hero-plane-4 {
    offset-path: path('M0 150 Q400 50 800 200 Q1100 320 1440 100');
    animation: flyRoute4 14s linear infinite;
    animation-delay: -11s;
  }
  @keyframes flyRoute4 {
    0% { offset-distance: 0%; opacity: 0; }
    5% { opacity: 0.35; }
    90% { opacity: 0.35; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* 🚢 Ship 1 — main sea route y≈600 */
  .hero-ship-1 {
    animation: sailShip1 30s linear infinite;
  }
  @keyframes sailShip1 {
    0% { transform: translate(-80px, 590px); opacity: 0; }
    3% { opacity: 0.5; }
    92% { opacity: 0.5; }
    100% { transform: translate(1500px, 610px); opacity: 0; }
  }

  /* 🚢 Ship 2 — lower sea route y≈650, staggered */
  .hero-ship-2 {
    animation: sailShip2 35s linear infinite;
    animation-delay: -15s;
  }
  @keyframes sailShip2 {
    0% { transform: translate(-60px, 640px); opacity: 0; }
    3% { opacity: 0.35; }
    92% { opacity: 0.35; }
    100% { transform: translate(1500px, 660px); opacity: 0; }
  }

  /* 🚛 Truck 1 — main land route y≈495 */
  .hero-truck-1 {
    animation: driveTruck1 25s linear infinite;
    animation-delay: -5s;
  }
  @keyframes driveTruck1 {
    0% { transform: translate(-60px, 488px); opacity: 0; }
    3% { opacity: 0.45; }
    92% { opacity: 0.45; }
    100% { transform: translate(1500px, 488px); opacity: 0; }
  }

  /* 🚛 Truck 2 — van, upper land route y≈525, staggered */
  .hero-truck-2 {
    animation: driveTruck2 20s linear infinite;
    animation-delay: -12s;
  }
  @keyframes driveTruck2 {
    0% { transform: translate(-50px, 518px); opacity: 0; }
    3% { opacity: 0.35; }
    92% { opacity: 0.35; }
    100% { transform: translate(1500px, 518px); opacity: 0; }
  }

  /* 🚛 Truck 3 — pickup, lower land route y≈545 */
  .hero-truck-3 {
    animation: driveTruck3 28s linear infinite;
    animation-delay: -20s;
  }
  @keyframes driveTruck3 {
    0% { transform: translate(-40px, 538px); opacity: 0; }
    3% { opacity: 0.3; }
    92% { opacity: 0.3; }
    100% { transform: translate(1500px, 538px); opacity: 0; }
  }

  /* Marquee */
  .marquee-container {
    --speed: 30s;
  }

  .marquee-track {
    animation: marquee var(--speed) linear infinite;
  }

  @media (max-width: 768px) {
    .marquee-container {
      --speed: 18s;
    }
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
