---
import { SITE } from '../../data/company';
import WAIcon from '../shared/WhatsAppIcon.astro';
---

<section class="section-padding bg-surface" id="layanan">
  <div class="max-w-7xl mx-auto text-center">
    <span class="inline-block text-accent uppercase tracking-widest text-xs md:text-sm font-semibold mb-3">
      Layanan Kami
    </span>
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-primary mb-4">
      Layanan Logistik Spesial
    </h2>
    <p class="text-gray-500 max-w-xl mx-auto mb-12 text-sm md:text-base">
      Kami menyediakan layanan pengiriman barang yang handal dan efisien.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {SITE.services.map((service) => (
        <div class="bg-white rounded-xl shadow-md card-hover group overflow-hidden">
          <div class="relative h-48 overflow-hidden">
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent"></div>
            <div class="absolute bottom-4 left-4 w-12 h-12 bg-primary rounded-lg shadow-md flex items-center justify-center">
              <img src={service.icon} alt="" class="w-7 h-7 object-contain" loading="lazy" />
            </div>
          </div>
          <div class="p-6 text-left">
            <h3 class="text-lg font-bold text-primary mb-2">{service.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-4">{service.shortDesc}</p>
            <a
              href={`/service/${service.slug}/`}
              class="inline-flex items-center gap-1.5 text-accent font-semibold text-sm hover:gap-2.5 transition-all duration-200"
            >
              Selengkapnya
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12">
      <a
        href={SITE.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        <WAIcon />
        Hubungi Kami
      </a>
    </div>
  </div>
</section>
