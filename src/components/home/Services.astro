---
import { SITE } from '../../data/company';
---

<section class="section-padding bg-surface" id="layanan">
  <div class="max-w-7xl mx-auto text-center">
    <span class="inline-block text-accent uppercase tracking-widest text-xs md:text-sm font-semibold mb-3">
      Layanan Kami
    </span>
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-primary mb-4">
      Layanan Logistik Spesial
    </h2>
    <p class="text-gray-500 max-w-xl mx-auto mb-12 text-sm md:text-base">
      Kami menyediakan layanan pengiriman barang yang handal dan efisien.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {SITE.services.map((service) => (
        <div class="bg-white rounded-xl shadow-md card-hover group overflow-hidden">
          <div class="relative h-48 overflow-hidden">
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent"></div>
            <div class="absolute bottom-4 left-4 w-12 h-12 bg-white rounded-lg shadow-md flex items-center justify-center">
              <img src={service.icon} alt="" class="w-7 h-7 object-contain" loading="lazy" />
            </div>
          </div>
          <div class="p-6 text-left">
            <h3 class="text-lg font-bold text-primary mb-2">{service.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-4">{service.shortDesc}</p>
            <a
              href={`/service/${service.slug}/`}
              class="inline-flex items-center gap-1.5 text-accent font-semibold text-sm hover:gap-2.5 transition-all duration-200"
            >
              Selengkapnya
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12">
      <a
        href={SITE.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Hubungi Kami
      </a>
    </div>
  </div>
</section>
