---
import { SITE } from '../../data/company';
import WAIcon from './WhatsAppIcon.astro';
---

<div class="fixed bottom-6 right-6 z-40 group" id="wa-float">
  <a
    href={SITE.whatsappLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat via WhatsApp"
    class="wa-bubble relative flex items-center gap-2.5 bg-[#25D366] hover:bg-[#1ebe57] text-white pl-4 pr-5 py-3 rounded-full shadow-lg hover:shadow-2xl transition-all duration-300"
  >
    <WAIcon class="w-7 h-7 text-white flex-shrink-0 relative z-10" />
    <span class="text-sm font-semibold whitespace-nowrap">Butuh Kirim Barang?</span>
  </a>
</div>

<style>
  .wa-bubble {
    animation: waBounce 3s ease-in-out 2s 2, waPulse 2s ease-in-out 8s infinite;
  }
  @keyframes waBounce {
    0%, 100% { transform: translateY(0); }
    25% { transform: translateY(-6px); }
    50% { transform: translateY(0); }
    75% { transform: translateY(-3px); }
  }
  @keyframes waPulse {
    0%, 100% { box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4); }
    50% { box-shadow: 0 4px 25px rgba(37, 211, 102, 0.7); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-bubble { animation: none !important; }
  }
</style>
