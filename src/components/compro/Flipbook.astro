---
export interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
const totalPages = images.length;
const leafCount = Math.ceil(totalPages / 2);

const leaves: { front: number | null; back: number | null }[] = [];
for (let i = 0; i < leafCount; i++) {
  const frontIdx = i * 2;
  const backIdx = i * 2 + 1;
  leaves.push({
    front: frontIdx < totalPages ? frontIdx : null,
    back: backIdx < totalPages ? backIdx : null,
  });
}
---

<div id="flipbook-container" class="fb-wrap">
  <div class="fb-scene" id="fb-scene">
    <div class="fb-book" id="fb-book">

      {leaves.map((leaf, i) => (
        <div class="fb-leaf" data-leaf={i} data-state="right" style={`z-index: ${leafCount - i};`}>
          <div class="fb-face fb-front">
            {leaf.front !== null ? (
              <img src={images[leaf.front].src} alt={images[leaf.front].alt}
                loading={i < 2 ? 'eager' : 'lazy'} decoding={i < 2 ? 'sync' : 'async'}
                width="1654" height="2339" />
            ) : <div class="fb-empty"></div>}
          </div>
          <div class="fb-face fb-back">
            {leaf.back !== null ? (
              <img src={images[leaf.back].src} alt={images[leaf.back].alt}
                loading={i < 2 ? 'eager' : 'lazy'} decoding={i < 2 ? 'sync' : 'async'}
                width="1654" height="2339" />
            ) : <div class="fb-empty"></div>}
          </div>
          <div class="fb-flip-shadow"></div>
        </div>
      ))}

      <div class="fb-spine"></div>
    </div>
  </div>

  <div class="fb-ctrl">
    <button id="fb-prev" class="fb-btn" aria-label="Sebelumnya" disabled>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="fb-info">
      <span id="fb-p1">1</span><span class="fb-dash" id="fb-dash">&mdash;</span><span id="fb-p2" style="display:none">2</span>
      <span class="fb-slash">/</span><span id="fb-end">{totalPages}</span>
    </div>
    <button id="fb-next" class="fb-btn" aria-label="Selanjutnya">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>

  <div class="fb-thumbs" id="fb-thumbs">
    {images.map((img, i) => (
      <button class:list={['fb-t', i === 0 && 'fb-t-on']} data-p={i} aria-label={`Hal. ${i+1}`}>
        <img src={img.src} alt={`T${i+1}`} loading="lazy" width="1654" height="2339" />
        <span class="fb-tn">{i+1}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .fb-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
  }

  /* ── Scene ── */
  .fb-scene {
    width: 100%;
    max-width: 900px;
    position: relative;
    perspective: 2800px;
  }
  .fb-scene::before {
    content: '';
    display: block;
    padding-bottom: 70.7%;
  }

  /* ── Book ── */
  .fb-book {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #f3f4f6;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.35), 0 0 0 1px rgba(0,0,0,0.06);
  }

  /* ── Leaf ── */
  .fb-leaf {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    transform-origin: left center;
    transform-style: preserve-3d;
    cursor: pointer;
  }
  .fb-leaf[data-state="right"] { transform: rotateY(0deg); }
  .fb-leaf[data-state="left"]  { transform: rotateY(-180deg); }

  /* ── Single page mode (cover / back cover) ── */
  .fb-leaf.fb-single {
    left: 0 !important;
    right: auto !important;
    width: 100% !important;
    transform-origin: center center;
    transition: width 0.3s ease-out 0.05s, left 0.3s ease-out 0.05s;
  }

  /* ── Faces ── */
  .fb-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    overflow: hidden;
    background: white;
  }
  .fb-face img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .fb-front { z-index: 2; }
  .fb-back  { transform: rotateY(180deg); z-index: 1; }
  .fb-empty { width: 100%; height: 100%; background: #f3f4f6; }

  /* Edge shadow on front */
  .fb-front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.05) 0%, transparent 10%);
    pointer-events: none;
  }

  /* ── Flip shadow ── */
  .fb-flip-shadow {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(to left, rgba(0,0,0,0.3), transparent 50%);
  }

  /* ── Animations ── */
  @keyframes flipNext {
    0%   { transform: rotateY(0deg) translateZ(0); }
    30%  { transform: rotateY(-55deg) translateZ(40px); }
    50%  { transform: rotateY(-90deg) translateZ(50px); }
    70%  { transform: rotateY(-130deg) translateZ(35px); }
    100% { transform: rotateY(-180deg) translateZ(0); }
  }
  @keyframes flipPrev {
    0%   { transform: rotateY(-180deg) translateZ(0); }
    30%  { transform: rotateY(-125deg) translateZ(40px); }
    50%  { transform: rotateY(-90deg) translateZ(50px); }
    70%  { transform: rotateY(-50deg) translateZ(35px); }
    100% { transform: rotateY(0deg) translateZ(0); }
  }
  @keyframes shadowPulse {
    0%   { opacity: 0; }
    30%  { opacity: 0.7; }
    70%  { opacity: 0.7; }
    100% { opacity: 0; }
  }

  .fb-leaf.anim-next {
    animation: flipNext 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  .fb-leaf.anim-prev {
    animation: flipPrev 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }
  .fb-leaf.anim-next .fb-flip-shadow,
  .fb-leaf.anim-prev .fb-flip-shadow {
    animation: shadowPulse 0.65s ease-in-out forwards;
  }

  /* ── Spine ── */
  .fb-spine {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 30px;
    height: 100%;
    background: linear-gradient(to right,
      transparent, rgba(0,0,0,0.04) 30%,
      rgba(0,0,0,0.08) 50%,
      rgba(0,0,0,0.04) 70%, transparent);
    z-index: 9999;
    pointer-events: none;
  }
  .fb-book.hide-spine .fb-spine { opacity: 0; }

  /* ── Controls ── */
  .fb-ctrl {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .fb-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 2px solid #021B43;
    background: white;
    color: #021B43;
    cursor: pointer;
    transition: all 0.2s;
  }
  .fb-btn:hover:not(:disabled) { background: #021B43; color: white; }
  .fb-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .fb-btn svg { width: 1.25rem; height: 1.25rem; }

  .fb-info {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: #021B43;
    min-width: 5.5rem;
    justify-content: center;
  }
  .fb-dash, .fb-slash { color: #9ca3af; }

  /* ── Thumbnails ── */
  .fb-thumbs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.5rem 0;
    max-width: 100%;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .fb-thumbs::-webkit-scrollbar { height: 4px; }
  .fb-thumbs::-webkit-scrollbar-track { background: #f3f4f6; border-radius: 2px; }
  .fb-thumbs::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 2px; }

  .fb-t {
    flex-shrink: 0;
    width: 3rem;
    aspect-ratio: 1654 / 2339;
    border-radius: 0.375rem;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    scroll-snap-align: start;
    background: white;
    padding: 0;
  }
  .fb-t img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fb-t:hover { border-color: #021B43; transform: translateY(-2px); }
  .fb-t-on { border-color: #FF5001 !important; box-shadow: 0 0 0 2px rgba(255,80,1,0.2); }
  .fb-tn {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: rgba(0,0,0,0.55);
    color: white;
    font-size: 0.55rem;
    text-align: center;
    padding: 1px 0;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .fb-scene { max-width: 420px; }
    .fb-scene::before { padding-bottom: 141.5%; }
    .fb-leaf { width: 100%; right: 0; }
    .fb-spine { display: none; }
    .fb-front::after { background: linear-gradient(to left, rgba(0,0,0,0.03) 0%, transparent 6%); }
    .fb-t { width: 2.5rem; }
    .fb-btn { width: 2.5rem; height: 2.5rem; }
  }
</style>

<script define:vars={{ totalPages, leafCount }}>
  const book = document.getElementById('fb-book');
  const scene = document.getElementById('fb-scene');
  const leafEls = document.querySelectorAll('.fb-leaf');
  const prevBtn = document.getElementById('fb-prev');
  const nextBtn = document.getElementById('fb-next');
  const p1Span = document.getElementById('fb-p1');
  const p2Span = document.getElementById('fb-p2');
  const dashEl = document.getElementById('fb-dash');
  const thumbs = document.querySelectorAll('.fb-t');

  let currentLeaf = 0;
  let isAnimating = false;
  const ANIM_DUR = 650;

  // ── Sound ──
  let audioCtx = null;
  function playFlipSound() {
    try {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const ctx = audioCtx;
      const dur = 0.18;
      const sr = ctx.sampleRate;
      const len = Math.floor(sr * dur);
      const buf = ctx.createBuffer(1, len, sr);
      const d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) {
        const t = i / len;
        const env = Math.exp(-t * 14) * 0.5 + Math.exp(-t * 5) * 0.35;
        d[i] = (Math.random() * 2 - 1) * env;
      }
      const src = ctx.createBufferSource();
      src.buffer = buf;
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass'; bp.frequency.value = 3500; bp.Q.value = 0.7;
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass'; hp.frequency.value = 600;
      const gain = ctx.createGain();
      gain.gain.value = 0.3;
      src.connect(bp); bp.connect(hp); hp.connect(gain); gain.connect(ctx.destination);
      src.start(ctx.currentTime);
      src.stop(ctx.currentTime + dur);
    } catch (e) {}
  }

  // ── Page visibility ──
  function getVisible() {
    if (currentLeaf === 0) return { left: null, right: 1 };
    if (currentLeaf >= leafCount) return { left: totalPages, right: null };
    return { left: currentLeaf * 2, right: currentLeaf * 2 + 1 };
  }

  // ── Render ──
  function renderLayout() {
    const isCover = currentLeaf === 0;
    const isBack = currentLeaf >= leafCount;

    // Single page mode
    leafEls.forEach((leaf, i) => {
      const wasSingle = leaf.classList.contains('fb-single');
      const shouldSingle =
        (isCover && i === 0 && leaf.dataset.state === 'right') ||
        (isBack && i === leafCount - 1 && leaf.dataset.state === 'left');

      if (shouldSingle && !wasSingle) {
        // Adding fb-single — the CSS transition on .fb-single handles the smoothness
        leaf.classList.add('fb-single');
      } else if (!shouldSingle && wasSingle) {
        leaf.classList.remove('fb-single');
      }
    });

    // Spine
    book.classList.toggle('hide-spine', isCover || isBack);

    // Z-index
    leafEls.forEach((leaf, i) => {
      leaf.style.zIndex = i < currentLeaf ? i + 1 : leafCount - i;
    });

    // Page info
    const v = getVisible();
    if (v.left && v.right) {
      p1Span.textContent = v.left;
      p2Span.textContent = v.right;
      p2Span.style.display = '';
      dashEl.style.display = '';
    } else {
      p1Span.textContent = v.left || v.right || 1;
      p2Span.style.display = 'none';
      dashEl.style.display = 'none';
    }

    // Buttons
    prevBtn.disabled = currentLeaf === 0;
    nextBtn.disabled = currentLeaf >= leafCount;

    // Thumbs
    const active = new Set();
    if (v.left) active.add(v.left - 1);
    if (v.right) active.add(v.right - 1);
    thumbs.forEach((t, i) => t.classList.toggle('fb-t-on', active.has(i)));
    const first = thumbs[v.left ? v.left - 1 : (v.right ? v.right - 1 : 0)];
    if (first) first.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  }

  // ── Flip next ──
  function flipNext() {
    if (isAnimating || currentLeaf >= leafCount) return;
    const leaf = leafEls[currentLeaf];
    if (!leaf) return;

    isAnimating = true;
    playFlipSound();

    const isSingle = leaf.classList.contains('fb-single');

    leaf.classList.add('anim-next');

    // If cover: remove fb-single at midpoint when page is edge-on (invisible)
    if (isSingle) {
      setTimeout(() => { leaf.classList.remove('fb-single'); }, ANIM_DUR * 0.45);
    }

    leaf.addEventListener('animationend', function done() {
      leaf.removeEventListener('animationend', done);
      leaf.classList.remove('anim-next');
      leaf.dataset.state = 'left';
      // Safety: ensure fb-single is removed after animation
      leaf.classList.remove('fb-single');
      currentLeaf++;
      renderLayout();
      setTimeout(() => { isAnimating = false; }, 30);
    });
  }

  // ── Flip prev ──
  function flipPrev() {
    if (isAnimating || currentLeaf <= 0) return;
    const leaf = leafEls[currentLeaf - 1];
    if (!leaf) return;

    isAnimating = true;
    playFlipSound();

    // If back-cover going to spread: remove fb-single at midpoint
    const isSingle = leaf.classList.contains('fb-single');
    if (isSingle) {
      setTimeout(() => { leaf.classList.remove('fb-single'); }, ANIM_DUR * 0.45);
    }

    leaf.classList.add('anim-prev');

    leaf.addEventListener('animationend', function done() {
      leaf.removeEventListener('animationend', done);
      leaf.classList.remove('anim-prev');
      leaf.dataset.state = 'right';
      leaf.classList.remove('fb-single');
      currentLeaf--;
      renderLayout();
      setTimeout(() => { isAnimating = false; }, 30);
    });
  }

  // ── Jump to page ──
  function goTo(target) {
    if (isAnimating || target === currentLeaf) return;
    target = Math.max(0, Math.min(leafCount, target));
    isAnimating = true;
    playFlipSound();
    for (let i = 0; i < leafCount; i++) {
      leafEls[i].dataset.state = i < target ? 'left' : 'right';
      leafEls[i].classList.remove('fb-single', 'anim-next', 'anim-prev');
    }
    currentLeaf = target;
    renderLayout();
    setTimeout(() => { isAnimating = false; }, 100);
  }

  // ── Events ──
  prevBtn?.addEventListener('click', flipPrev);
  nextBtn?.addEventListener('click', flipNext);

  book?.addEventListener('click', (e) => {
    const rect = book.getBoundingClientRect();
    if (e.clientX - rect.left < rect.width / 2) flipPrev();
    else flipNext();
  });

  thumbs.forEach((t) => {
    t.addEventListener('click', () => {
      const pi = parseInt(t.dataset.p || '0', 10);
      goTo(Math.ceil((pi + 1) / 2));
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); flipPrev(); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); flipNext(); }
  });

  let tx = 0, ty = 0, tt = 0;
  scene?.addEventListener('touchstart', (e) => {
    tx = e.touches[0].clientX; ty = e.touches[0].clientY; tt = Date.now();
  }, { passive: true });
  scene?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - tx;
    const dy = e.changedTouches[0].clientY - ty;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5 && Date.now() - tt < 500) {
      dx > 0 ? flipPrev() : flipNext();
    }
  }, { passive: true });

  // Init
  renderLayout();
</script>
