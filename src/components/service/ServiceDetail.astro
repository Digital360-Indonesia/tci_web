---
import Breadcrumb from '../shared/Breadcrumb.astro';
import { SITE } from '../../data/company';

interface Props {
  title: string;
  image: string;
  description: string;
  slug: string;
  features: string[];
  strengths: string[];
}

const { title, image, description, slug, features, strengths } = Astro.props;
---

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <Breadcrumb items={[
    { label: 'Detail Layanan', href: '/' },
    { label: title },
  ]} />

  <div class="relative rounded-xl overflow-hidden mb-10">
    <img
      src={image}
      alt={title}
      class="w-full h-64 sm:h-80 lg:h-96 object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#021B43]/80 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white">{title}</h1>
    </div>
  </div>

  <p class="text-gray-700 leading-relaxed text-lg mb-12 max-w-4xl">{description}</p>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
    <div class="bg-gray-50 rounded-xl p-6 sm:p-8 border border-gray-100">
      <h2 class="text-xl font-bold text-[#021B43] mb-4">Freight Overview</h2>
      <ul class="space-y-3">
        {features.map((feature) => (
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-[#FF5001] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span class="text-gray-700">{feature}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="bg-gray-50 rounded-xl p-6 sm:p-8 border border-gray-100">
      <h2 class="text-xl font-bold text-[#021B43] mb-4">Keunggulan Kami</h2>
      <ul class="space-y-3">
        {strengths.map((strength) => (
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-[#FF5001] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-gray-700">{strength}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="bg-[#021B43] rounded-xl p-8 sm:p-12 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Tertarik dengan layanan {title}?</h2>
    <p class="text-gray-300 mb-6 max-w-2xl mx-auto">Hubungi kami sekarang untuk konsultasi dan penawaran terbaik.</p>
    <a
      href={SITE.whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 bg-[#FF5001] hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-lg transition-colors"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Hubungi Kami
    </a>
  </div>

</div>
