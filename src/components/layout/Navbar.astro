---
import { SITE } from '../../data/company';

const currentPath = Astro.url.pathname;

const menuItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Cek Resi', href: SITE.app.cekResi },
  { label: 'Cek Harga', dropdown: true, items: [
    { label: 'Udara (Port to Port)', href: SITE.app.cekHargaPtp },
    { label: 'Udara (Door to Door)', href: SITE.app.cekHargaDtd },
    { label: 'Darat', href: SITE.app.cekHargaDarat },
    { label: 'Darat & Laut', href: SITE.app.cekHargaDaratLaut },
    { label: 'Laut', href: SITE.app.cekHargaLaut },
  ]},
  { label: 'Tentang', href: '/tentang/' },
  { label: 'Berita', href: '/berita/' },
  { label: 'Kontak', href: '/kontak/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<div class="relative" id="navbar-wrapper">
  <!-- Topbar (desktop only) -->
  <div id="topbar" class="hidden lg:block bg-primary text-white text-sm">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-10">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {SITE.address}
        </span>
      </div>
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <a href={`mailto:${SITE.email}`} class="hover:text-accent transition-colors">{SITE.email}</a>
      </div>
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1.5 text-white/60">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {SITE.phone}
        </span>
        <span class="text-white/30">|</span>
        <a href={`https://wa.me/6281252595159`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-accent transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          {SITE.whatsapp}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <nav id="main-nav" class="bg-white/95 backdrop-blur-md transition-shadow duration-300 z-50 border-b border-transparent">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0">
        <img src="/images/brand/tci-logo.png" alt="Terminal Cargo Indonesia" class="h-10 lg:h-12 w-auto" />
      </a>

      <!-- Desktop Menu -->
      <div class="hidden lg:flex items-center gap-1">
        {menuItems.map((item) => (
          item.dropdown ? (
            <div class="relative group" id="harga-dropdown-wrapper">
              <button
                class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-accent transition-colors flex items-center gap-1 rounded-lg"
                aria-expanded="false"
                aria-haspopup="true"
                id="harga-dropdown-btn"
              >
                {item.label}
                <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200" id="harga-dropdown-menu">
                <div class="bg-white rounded-xl shadow-xl border border-gray-100 py-2 min-w-[260px]">
                  {item.items?.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary transition-colors"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class:list={[
                'px-3 py-2 text-sm font-medium transition-colors rounded-lg',
                item.external ? 'text-gray-700 hover:text-accent' :
                isActive(item.href) ? 'text-accent font-semibold' : 'text-gray-700 hover:text-accent'
              ]}
            >
              {item.label}
            </a>
          )
        ))}
        <a
          href={SITE.app.login}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-4 bg-accent hover:bg-accent-600 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-all duration-200 shadow-md hover:shadow-lg"
        >
          Login
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden relative w-10 h-10 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <div class="w-6 h-5 relative flex flex-col justify-between" id="hamburger-icon">
          <span class="block h-0.5 w-6 bg-gray-800 rounded transition-all duration-300 origin-center" id="bar1"></span>
          <span class="block h-0.5 w-6 bg-gray-800 rounded transition-all duration-300" id="bar2"></span>
          <span class="block h-0.5 w-6 bg-gray-800 rounded transition-all duration-300 origin-center" id="bar3"></span>
        </div>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div id="mobile-overlay" class="fixed inset-0 bg-black/50 z-[60] opacity-0 invisible transition-all duration-300 lg:hidden"></div>
  <div id="mobile-drawer" class="fixed top-0 right-0 h-full w-80 max-w-[85vw] bg-white z-[70] transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden shadow-2xl">
    <div class="flex flex-col h-full">
      <!-- Drawer Header -->
      <div class="flex items-center justify-between px-4 h-16 border-b border-gray-100">
        <img src="/images/brand/tci-logo.png" alt="TCI" class="h-8 w-auto" />
        <button id="mobile-close-btn" class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors" aria-label="Close menu">
          <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Drawer Body -->
      <div class="flex-1 overflow-y-auto py-4">
        <div class="space-y-1 px-3">
          {menuItems.map((item) => (
            item.dropdown ? (
              <div class="mobile-dropdown">
                <button
                  class="w-full flex items-center justify-between px-3 py-3 text-base font-medium text-gray-700 hover:text-accent hover:bg-gray-50 rounded-lg transition-colors"
                  data-toggle="mobile-harga"
                >
                  {item.label}
                  <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div id="mobile-harga" class="hidden pl-4 space-y-1">
                  {item.items?.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-3 py-2.5 text-sm text-gray-600 hover:text-accent hover:bg-gray-50 rounded-lg transition-colors"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class:list={[
                  'block px-3 py-3 text-base font-medium rounded-lg transition-colors',
                  item.external ? 'text-gray-700 hover:text-accent hover:bg-gray-50' :
                  isActive(item.href) ? 'text-accent bg-accent-50 font-semibold' : 'text-gray-700 hover:text-accent hover:bg-gray-50'
                ]}
              >
                {item.label}
              </a>
            )
          ))}
        </div>
        <div class="px-6 mt-6 pt-6 border-t border-gray-100">
          <a
            href={SITE.app.login}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full justify-center text-center"
          >
            Login
          </a>
        </div>
        <div class="px-6 mt-6 space-y-3 text-sm text-gray-600">
          <span class="flex items-center gap-2 text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            {SITE.phone}
          </span>
          <a href={`mailto:${SITE.email}`} class="flex items-center gap-2 hover:text-accent transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            {SITE.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  declare const window: Window & { __navInit?: boolean };

  const NAV_STICKY_BREAKPOINT = 1024;
  let spacer: HTMLDivElement | null = null;

  function getNav() {
    return {
      mainNav: document.getElementById('main-nav'),
      wrapper: document.getElementById('navbar-wrapper'),
      topbar: document.getElementById('topbar'),
    };
  }

  // ── Desktop Sticky Nav ──
  function updateStickyNav() {
    const { mainNav, wrapper } = getNav();
    if (!mainNav || !wrapper) return;
    const isDesktop = window.innerWidth >= NAV_STICKY_BREAKPOINT;

    if (isDesktop) {
      const topbar = document.getElementById('topbar');
      const topbarH = topbar ? topbar.offsetHeight : 0;
      const navH = mainNav.offsetHeight;
      const scrollY = window.scrollY;

      if (scrollY > topbarH) {
        mainNav.style.position = 'fixed';
        mainNav.style.top = '0';
        mainNav.style.left = '0';
        mainNav.style.right = '0';
        mainNav.classList.add('shadow-lg', 'border-gray-100');

        if (!spacer) {
          spacer = document.createElement('div');
          spacer.style.height = navH + 'px';
          wrapper.insertBefore(spacer, mainNav);
        }
      } else {
        mainNav.style.position = '';
        mainNav.style.top = '';
        mainNav.style.left = '';
        mainNav.style.right = '';
        mainNav.classList.remove('shadow-lg', 'border-gray-100');

        if (spacer) {
          spacer.remove();
          spacer = null;
        }
      }
    } else {
      // Mobile: reset
      mainNav.style.position = '';
      mainNav.style.top = '';
      mainNav.style.left = '';
      mainNav.style.right = '';
      mainNav.classList.remove('shadow-lg', 'border-gray-100');
      if (spacer) {
        spacer.remove();
        spacer = null;
      }
    }
  }

  // ── Mobile Drawer ──
  let drawerOpen = false;

  function toggleDrawer(open: boolean) {
    drawerOpen = open;
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('mobile-overlay');
    const btn = document.getElementById('mobile-menu-btn');
    const b1 = document.getElementById('bar1');
    const b2 = document.getElementById('bar2');
    const b3 = document.getElementById('bar3');

    drawer?.classList.toggle('translate-x-full', !open);
    drawer?.classList.toggle('translate-x-0', open);
    overlay?.classList.toggle('opacity-0', !open);
    overlay?.classList.toggle('invisible', !open);
    overlay?.classList.toggle('opacity-100', open);
    overlay?.classList.toggle('visible', open);
    btn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';

    if (b1 && b2 && b3) {
      b1.classList.toggle('rotate-45', open);
      b1.classList.toggle('translate-y-[9px]', open);
      b2.classList.toggle('opacity-0', open);
      b3.classList.toggle('-rotate-45', open);
      b3.classList.toggle('-translate-y-[9px]', open);
    }
  }

  // ── Init all listeners (runs on every page load + SPA swap) ──
  function initNavbar() {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileCloseBtn = document.getElementById('mobile-close-btn');
    const mobileOverlay = document.getElementById('mobile-overlay');
    const hargaBtn = document.getElementById('harga-dropdown-btn');

    // Reset sticky state on new page
    spacer = null;

    // Mobile drawer
    mobileBtn?.addEventListener('click', () => toggleDrawer(!drawerOpen));
    mobileCloseBtn?.addEventListener('click', () => toggleDrawer(false));
    mobileOverlay?.addEventListener('click', () => toggleDrawer(false));

    // Desktop harga dropdown
    hargaBtn?.addEventListener('click', () => {
      const menu = document.getElementById('harga-dropdown-menu');
      if (menu) {
        const isVisible = menu.classList.contains('visible');
        menu.classList.toggle('opacity-0', isVisible);
        menu.classList.toggle('invisible', isVisible);
        menu.classList.toggle('opacity-100', !isVisible);
        menu.classList.toggle('visible', !isVisible);
        hargaBtn.setAttribute('aria-expanded', String(!isVisible));
      }
    });

    // Mobile harga dropdown
    document.querySelectorAll('[data-toggle="mobile-harga"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-toggle');
        const target = document.getElementById(targetId!);
        const svg = btn.querySelector('svg');
        target?.classList.toggle('hidden');
        svg?.classList.toggle('rotate-180');
      });
    });

    // Check sticky state immediately for current scroll position
    updateStickyNav();
  }

  // ── Global listeners (only once) ──
  if (!window.__navInit) {
    window.__navInit = true;

    window.addEventListener('scroll', updateStickyNav, { passive: true });
    window.addEventListener('resize', updateStickyNav, { passive: true });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggleDrawer(false);
    });
  }

  // ── First load ──
  initNavbar();

  // ── Re-init after SPA navigation ──
  document.addEventListener('astro:after-swap', () => {
    initNavbar();
  });
</script>
