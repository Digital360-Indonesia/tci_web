---
import { SITE } from '../../data/company';

const currentYear = new Date().getFullYear();

const hargaLinks = [
  { label: 'Cek Harga Udara (PTP)', href: SITE.app.cekHargaPtp },
  { label: 'Cek Harga Udara (DTD)', href: SITE.app.cekHargaDtd },
  { label: 'Cek Harga Darat', href: SITE.app.cekHargaDarat },
  { label: 'Cek Harga Darat & Laut', href: SITE.app.cekHargaDaratLaut },
  { label: 'Cek Harga Laut', href: SITE.app.cekHargaLaut },
];

const otherLinks = [
  { label: 'Kargo Udara', href: '/service/kargo-udara/' },
  { label: 'Kargo Laut', href: '/service/kargo-laut/' },
  { label: 'Kargo Darat', href: '/service/kargo-darat/' },
  { label: 'Tentang Kami', href: '/tentang/' },
  { label: 'Berita & Artikel', href: '/berita/' },
];
---

<footer class="bg-primary text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4">

    <!-- Row 1: Tagline -->
    <div class="py-8 border-b border-white/10">
      <p class="text-white text-xl sm:text-2xl md:text-3xl lg:text-4xl font-semibold tracking-wide leading-tight">
        From Surabaya to everywhere — your trusted gateway.<br/>
        <span class="text-white">by Terminal Cargo Indonesia</span>.
      </p>
    </div>

    <!-- Row 2: 4 Columns -->
    <div class="py-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

      <!-- Col 1: Alamat -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">Alamat</h3>
        <div class="flex items-start gap-2.5 text-sm text-gray-300 mb-4">
          <svg class="w-5 h-5 text-accent mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <p>{SITE.address}</p>
        </div>
        <a
          href={SITE.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-accent hover:text-accent-300 text-sm font-medium transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Lihat di Google Maps
        </a>
      </div>

      <!-- Col 2: Menu Cek Harga -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">Cek Harga</h3>
        <ul class="space-y-2.5">
          {hargaLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-300 text-sm hover:text-accent transition-colors flex items-center gap-1.5">
                <svg class="w-2.5 h-2.5 flex-shrink-0 text-accent/50" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Menu Lainnya -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">Navigasi</h3>
        <ul class="space-y-2.5">
          {otherLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-300 text-sm hover:text-accent transition-colors flex items-center gap-1.5">
                <svg class="w-2.5 h-2.5 flex-shrink-0 text-accent/50" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Kontak -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">Kontak</h3>
        <div class="space-y-3">
          <span class="flex items-center gap-2.5 text-sm text-gray-400">
            <svg class="w-4 h-4 text-white/30 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            {SITE.phone}
          </span>
          <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 text-sm text-gray-300 hover:text-accent transition-colors">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            {SITE.whatsapp}
          </a>
          <a href={`mailto:${SITE.email}`} class="flex items-center gap-2.5 text-sm text-gray-300 hover:text-accent transition-colors">
            <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            {SITE.email}
          </a>
        </div>
        <div class="mt-5 flex items-start gap-2 text-sm text-gray-400">
          <svg class="w-4 h-4 text-accent mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div>
            <p>{SITE.operationalHours}</p>
            <p class="text-gray-500 text-xs mt-0.5">{SITE.operationalNote}</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Row 3: Ghost Brand Name -->
    <div class="py-8 relative">
      <!-- Animated planes -->
      <div class="footer-plane-1 pointer-events-none" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
          <rect x="8" y="16" width="24" height="5" rx="2.5" fill="white"/>
          <path d="M15 16 L9 7 L20 7 L20 16 Z" fill="white" opacity="0.8"/>
          <path d="M15 21 L9 30 L20 30 L20 21 Z" fill="white" opacity="0.8"/>
          <path d="M8 16 L4 10 L11 10 L11 16 Z" fill="white" opacity="0.6"/>
        </svg>
      </div>
      <div class="footer-plane-2 pointer-events-none" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
          <rect x="8" y="16" width="24" height="5" rx="2.5" fill="white"/>
          <path d="M15 16 L9 7 L20 7 L20 16 Z" fill="white" opacity="0.8"/>
          <path d="M15 21 L9 30 L20 30 L20 21 Z" fill="white" opacity="0.8"/>
          <path d="M8 16 L4 10 L11 10 L11 16 Z" fill="white" opacity="0.6"/>
        </svg>
      </div>
      <div class="footer-plane-3 pointer-events-none" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 40 40" fill="none">
          <rect x="8" y="16" width="24" height="5" rx="2.5" fill="white"/>
          <path d="M15 16 L9 7 L20 7 L20 16 Z" fill="white" opacity="0.8"/>
          <path d="M15 21 L9 30 L20 30 L20 21 Z" fill="white" opacity="0.8"/>
          <path d="M8 16 L4 10 L11 10 L11 16 Z" fill="white" opacity="0.6"/>
        </svg>
      </div>
       <p class="footer-brand-text text-center text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black uppercase tracking-wider md:tracking-widest select-none whitespace-normal md:whitespace-nowrap leading-tight">
        Terminal Cargo Indonesia
      </p>
    </div>

  </div>

  <!-- Row 4: Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-gray-400 text-sm text-center md:text-left">
        &copy; {currentYear} {SITE.name}. All rights reserved.
      </p>
      <a href="https://digital360.id" target="_blank" rel="noopener noreferrer" class="text-gray-400 text-sm hover:text-accent transition-colors">
        Develop by Digital360
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-brand-text {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.15);
    transition: all 0.5s ease;
  }

  .footer-brand-text:hover {
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.8);
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-plane-1 {
    position: absolute;
    top: 0;
    left: -60px;
    animation: footerFly1 20s linear infinite;
  }
  .footer-plane-2 {
    position: absolute;
    top: 10px;
    left: -50px;
    animation: footerFly2 25s linear infinite;
    animation-delay: -8s;
  }
  .footer-plane-3 {
    position: absolute;
    top: 5px;
    left: -40px;
    animation: footerFly3 30s linear infinite;
    animation-delay: -16s;
  }

  @keyframes footerFly1 {
    0% { transform: translate(0, 20px) rotate(-5deg); opacity: 0; }
    5% { opacity: 0.6; }
    25% { transform: translate(25vw, -30px) rotate(0deg); }
    50% { transform: translate(50vw, -50px) rotate(3deg); }
    75% { transform: translate(75vw, -30px) rotate(0deg); }
    90% { opacity: 0.6; }
    100% { transform: translate(100vw, 20px) rotate(-5deg); opacity: 0; }
  }
  @keyframes footerFly2 {
    0% { transform: translate(0, 30px) rotate(-3deg); opacity: 0; }
    5% { opacity: 0.4; }
    25% { transform: translate(30vw, -15px) rotate(2deg); }
    50% { transform: translate(55vw, -40px) rotate(-2deg); }
    75% { transform: translate(80vw, -10px) rotate(1deg); }
    90% { opacity: 0.4; }
    100% { transform: translate(100vw, 25px) rotate(-3deg); opacity: 0; }
  }
  @keyframes footerFly3 {
    0% { transform: translate(0, 15px) rotate(-4deg); opacity: 0; }
    5% { opacity: 0.3; }
    25% { transform: translate(20vw, -20px) rotate(1deg); }
    50% { transform: translate(45vw, -35px) rotate(-1deg); }
    75% { transform: translate(70vw, -25px) rotate(2deg); }
    90% { opacity: 0.3; }
    100% { transform: translate(100vw, 10px) rotate(-4deg); opacity: 0; }
  }
</style>
